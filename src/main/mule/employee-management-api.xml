output application/json
---
{
    status: 400,
    message: "Please provide a valid email address."
}]]></ee:set-payload>
							</ee:message>
						</ee:transform>
					</when>
					<when expression='#[error.errorType.identifier == "BLANK_STRING"]'>
						<set-variable value="400" doc:name="Set Variable" doc:id="3c8a16c5-cb8e-4d9b-952b-bc4e9e30ede9" variableName="httpStatus"/>
						<ee:transform doc:name="Transform Message" doc:id="2d6152db-0144-43b8-8e34-f09e9b69180a" >
