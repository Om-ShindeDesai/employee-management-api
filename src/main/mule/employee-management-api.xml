    <flow name="put:\employees\(id):application\json:employee-management-api-config">
        <logger level="INFO" message="put:\employees\(id):application\json:employee-management-api-config" />
		<db:update doc:name="Update" doc:id="08c97375-efeb-44e4-a9a9-2010f4331b7e" config-ref="Database_Config">
			<db:sql ><![CDATA[UPDATE employees
SET name = :name,
    email = :email,
    department = :department,
    salary = :salary
WHERE id = :id]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
    id: attributes.uriParams.id as Number,
    name: payload.name,
    email: payload.email,
    department: payload.department,
    salary: payload.salary
}]]]></db:input-parameters>
		</db:update>
		<choice doc:name="Choice" doc:id="4f4f9311-d6a7-4d63-abe1-2321d1a91495" >
			<when expression="payload.affectedRows &gt; 0">
				<ee:transform doc:name="Transform Message" doc:id="e49ea1c6-91b6-47d5-8b26-1f9aa30a885a" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    message: "Employee updated successfully",
    id: attributes.uriParams.id
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<set-variable value="404" doc:name="Set Variable" doc:id="eabceca8-5799-4885-a9a9-e3207f2554e3" variableName="httpStatus"/>
				<ee:transform doc:name="Transform Message" doc:id="d4ca1c21-2397-44b3-aef9-73b0f221fcf0" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
