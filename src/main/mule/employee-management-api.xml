			<otherwise >
				<db:insert doc:name="Insert" doc:id="0ddd008c-a442-4be0-85af-23c699f48ffe" config-ref="Database_Config">
			<db:sql><![CDATA[INSERT INTO employees
(name, email, department, salary)
VALUES
(:name, :email, :department, :salary)]]></db:sql>
			<db:input-parameters><![CDATA[#[{
    name: vars.employeePayload.name,
    email: vars.employeePayload.email,
    department: vars.employeePayload.department,
    salary: vars.employeePayload.salary
}]]]></db:input-parameters>
